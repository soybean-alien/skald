<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional and not committed: set ValheimServerDir for your machine in Skald.local.props -->
  <Import Project="Skald.local.props" Condition="Exists('Skald.local.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Skald</AssemblyName>
    <RootNamespace>Skald</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Path to a Valheim dedicated server install with BepInEx; override with -p:ValheimServerDir=... -->
    <ValheimServerDir Condition="'$(ValheimServerDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server</ValheimServerDir>
    <ManagedDir>$(ValheimServerDir)\valheim_server_Data\Managed</ManagedDir>
    <BepInExDir>$(ValheimServerDir)\BepInEx</BepInExDir>
    <DeployToLab Condition="'$(DeployToLab)' == ''">false</DeployToLab>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ManagedDir)\Splatform.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToLabServer" AfterTargets="Build" Condition="'$(DeployToLab)' == 'true'">
    <MakeDir Directories="$(BepInExDir)\plugins\Skald" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\Skald" />
  </Target>

</Project>
